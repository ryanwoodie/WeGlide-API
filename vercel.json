{
  "version": 2,
  "routes": [
    { "src": "/widget.js", "dest": "/api/serve-widget.js" },
    { "src": "/api/data", "dest": "/api/serve-data.js" },
    { "src": "/sac-dsc", "dest": "/api/serve-leaderboard" },
    { "src": "/", "dest": "/api/serve-leaderboard" }
  ],
  "crons": [
    {
      "path": "/api/check-flights",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron-notify-top5",
      "schedule": "0 16 * * *"
    }
  ],
  "github": {
    "silent": true
  }
}
