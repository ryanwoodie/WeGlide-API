{
  "version": 2,
  "name": "sac-leaderboard",
  "routes": [
    { "src": "/debug-blob", "dest": "/api/debug-blob.js" },
    { "src": "/debug-token", "dest": "/api/debug-token.js" },
    { "src": "/sac-dsc", "dest": "/api/serve-leaderboard" },
    { "src": "/", "dest": "/api/serve-leaderboard" }
  ],
  "crons": [
    {
      "path": "/api/check-flights",
      "schedule": "0 3 * * *"
    }
  ]
}
