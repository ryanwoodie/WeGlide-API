rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public leaderboard can read verification records
    match /pilot_verifications/{pilotId} {
      allow read: if true;
      // Public anonymous writes are disabled
      allow write: if false;
    }

    // Public leaderboard can read DOB verification records
    match /dob_verifications/{pilotId} {
      allow read: if true;
      // Public anonymous writes are disabled
      allow write: if false;
    }
  }
}
